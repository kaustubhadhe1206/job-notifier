# Copy to .env for local development. On Vercel, add these in Project → Settings → Environment Variables.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_hex(24))"

# Supabase → Connect → Connection String → "Transaction pooler" (port 6543), with your DB password filled in
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Password for the dashboard (pick anything long)
ADMIN_PASSWORD=change-me

# Secret the every-minute pinger sends (letters and digits only)
CRON_SECRET=change-me-too

# Gmail: myaccount.google.com/apppasswords (needs 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcdefghijklmnop

# Where alerts go (optional, defaults to SMTP_USER)
NOTIFY_EMAIL=you@gmail.com

# Google Sheet (optional): the Apps Script web app URL (ends in /exec) and the secret you put in Code.gs
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEETS_SECRET=change-me-three

# Anthropic API key for the Claude Haiku AI check (optional; SETUP.md step 9)
ANTHROPIC_API_KEY=sk-ant-...

# Your Vercel URL (optional, adds a dashboard link to emails)
APP_URL=https://your-app.vercel.app
